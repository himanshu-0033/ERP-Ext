{
  "manifest_version": 3,
  "name": "IIT KGP ERP Autofill",
  "version": "2.0.0",
  "minimum_chrome_version": "114",
  "description": "Autofill your IIT Kharagpur ERP login from an encrypted local vault and request OTP with one click.",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "ERP Autofill", "default_popup": "popup.html" },
  "options_page": "options.html",
  "content_scripts": [{
    "matches": [
      "https://erp.iitkgp.ac.in/SSOAdministration/login.htm*",
      "https://erp.iitkgp.ac.in/IIT_ERP3/"
    ],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
